<!-- ClickHouse 자체의 프로메테우스 엔드포인트(13.1). 같은 도커 네트워크의 Prometheus 만 부른다. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
