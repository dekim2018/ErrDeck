# 오라클 서버의 .env(17.5). 이 파일을 복사해 값을 채운다. .env 는 저장소에 올리지 않는다.
ERRDECK_DOMAIN=errdeck.duckdns.org
ERRDECK_ACME_EMAIL=you@example.com

# openssl rand -base64 24 같은 것으로 만든다.
ERRDECK_DB_PASSWORD=
ERRDECK_CLICKHOUSE_PASSWORD=
ERRDECK_CLICKHOUSE_WORKER_PASSWORD=
ERRDECK_CLICKHOUSE_API_PASSWORD=
ERRDECK_GRAFANA_PASSWORD=
# 32바이트 이상. openssl rand -base64 48
ERRDECK_JWT_SECRET=
# Alertmanager 와 api 가 나눠 쓰는 비밀(15.1)
ERRDECK_INTERNAL_SECRET=
# 처음 관리자 계정을 만들 때만 true
ERRDECK_SIGNUP_ENABLED=true
# 다른 서버의 프로메테우스 에이전트가 쓰는 비밀번호의 해시.
# docker run --rm caddy:2 caddy hash-password --plaintext '비밀번호'
ERRDECK_AGENT_PASSWORD_HASH=
